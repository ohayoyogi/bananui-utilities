project('bananui-utilities', 'c', version: '0.2.0', license: 'MIT',
  meson_version: '>=0.56.0', default_options: ['c_std=gnu11', 'warning_level=2', 'werror=true'])
add_project_arguments('-Wno-unused-parameter', language: 'c')
glib = dependency('glib-2.0', version: '>=2.74')
gio = dependency('gio-2.0')
bananui = dependency('bananui2')
pango = dependency('pangocairo')
pixbuf = dependency('gdk-pixbuf-2.0')
math = meson.get_compiler('c').find_library('m')
core = static_library('utility-core', 'src/note-store.c', 'src/calculator.c', 'src/file-store.c', dependencies: [gio, math])
core_dep = declare_dependency(link_with: core, include_directories: include_directories('src'), dependencies: [gio, math])
j2me_core = static_library('j2me-core', 'src/j2me.c', dependencies: gio)
j2me_dep = declare_dependency(link_with: j2me_core, include_directories: include_directories('src'), dependencies: gio)
ui = static_library('utility-ui', 'src/ui.c', dependencies: [bananui, pango])
ui_dep = declare_dependency(link_with: ui, include_directories: include_directories('src'), dependencies: [bananui, pango])
executable('bananui-notes', 'src/notes.c', dependencies: [core_dep, ui_dep], install: true)
executable('bananui-calculator', 'src/calculator-app.c', dependencies: [core_dep, ui_dep], install: true)
executable('bananui-files', 'src/files.c', dependencies: [core_dep, ui_dep, pixbuf], install: true)
executable('bananui-j2me', 'src/j2me-app.c', dependencies: [j2me_dep, ui_dep], install: true)
install_data('data/org.bananui.Notes.desktop', 'data/org.bananui.Calculator.desktop', 'data/org.bananui.Files.desktop',
  'data/org.bananui.J2ME.desktop', install_dir: get_option('datadir') / 'applications')
install_data('data/utilities.ipt', install_dir: get_option('datadir') / 'bananui/scripts/themes')
core_test = executable('test-utilities', 'tests/test-core.c', dependencies: core_dep)
test('note-storage-and-calculator', core_test)
files_test = executable('test-files', 'tests/test-files.c', dependencies: core_dep)
test('file-storage', files_test)
j2me_test = executable('test-j2me', 'tests/test-j2me.c', dependencies: j2me_dep)
test('j2me-protocol', j2me_test)
executable('test-runtime-window', 'tests/runtime-window.c', dependencies: [ui_dep, gio])
executable('test-input-widget', 'tests/test-input-widget.c', dependencies: [bananui, pango])
